{
  "name": "fusen-windows",
  "productName": "ふせん",
  "version": "1.1.0",
  "description": "Windows向けの軽量な付箋アプリ",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "predev": "npm run icons",
    "dev": "electron-vite dev",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:product": "node scripts/product-smoke.mjs",
    "build": "npm run icons && electron-vite build",
    "dist": "npm run typecheck && npm run test && npm run build && npm run test:product && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --dir"
  },
  "build": {
    "appId": "jp.personal.fusen",
    "productName": "ふせん",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/tray.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Fusen-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ふせん",
      "include": "build/installer.nsh",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Fusen-Portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "@fluentui/react-icons": "^2.0.335",
    "@lexical/list": "^0.49.0",
    "@lexical/react": "^0.49.0",
    "lexical": "^0.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
